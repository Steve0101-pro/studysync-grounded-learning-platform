# Copy to .env and replace placeholders. Never commit .env or real secrets.
ENVIRONMENT=development

# Copy the PostgreSQL connection string from Supabase Dashboard > Connect.
# For pooler connections use the exact host, port, and username shown there.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET_NAME=documents

JWT_SECRET_KEY=<long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

NVIDIA_API_KEY=<nvidia-api-key>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
STUDY_TUTOR_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_VISION_FALLBACK_MODEL=meta/llama-3.2-11b-vision-instruct

GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=whisper-large-v3-turbo
GROQ_STT_FALLBACK_MODEL=whisper-large-v3
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional final chat fallback. Groq is used when this is unset.
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4-turbo

# Bounded external-model request limits; SDK retries apply only to transient errors.
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_READ_TIMEOUT_SECONDS=60
MODEL_WRITE_TIMEOUT_SECONDS=60
MODEL_POOL_TIMEOUT_SECONDS=5
MODEL_MAX_RETRIES=1
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Optional Qdrant Cloud. If QDRANT_URL is empty, the app uses persistent
# local Qdrant storage in .qdrant and falls back to lexical retrieval on errors.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=.qdrant
STUDY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STUDY_LATE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-small-en-tokens
# Set this if Tesseract is not available on PATH (especially on Windows).
TESSERACT_CMD=

# Optional Neo4j knowledge graph for topic/concept relationships.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:8501
